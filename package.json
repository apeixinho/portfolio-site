    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "regenerator-runtime": "^0.14.1",
    "rimraf": "^5.0.10",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "vanillajs-scrollspy": "^2.2.1",
    "webpack": "^5.107.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.4",
