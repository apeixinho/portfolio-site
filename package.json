  "license": "GPL-3.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && webpack --progress --mode development --config webpack.config.dev.js",
    "build:prod": "npm run clean && webpack --progress --mode production --config webpack.config.prod.js",
    "start": "webpack serve --mode development --config webpack.config.dev.js",
    "start:prod": "webpack serve --mode production --config webpack.config.prod.js",
    "start:server": "node server.js"
  },
  "browserslist": [
    "> .01%",
    "not dead",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 1 Edge versions",
    "last 1 version",
    "Firefox ESR",
    "not ie <= 11"
  ],
  "dependencies": {
    "express": "^4.22.2",
    "express-graceful-shutdown": "^1.1.3",
    "helmet": "^7.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "animate.css": "^3.7.2",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^9.2.1",
    "compression-webpack-plugin": "^11.1.0",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.49.0",
    "css-loader": "^7.1.4",
    "ejs": "^2.7.4",
    "ejs-compiled-loader": "^1.1.0",
    "eslint": "^8.57.1",
